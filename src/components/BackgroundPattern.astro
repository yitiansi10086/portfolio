---
---
<div class="background-pattern" aria-hidden="true">
  <svg class="pattern-svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- 双层嵌套像素霓虹框 - 左上 -->
    <g class="frame-top-left breathe">
      <rect x="30" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="38" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="46" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="54" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="62" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="70" y="25" width="8" height="8" fill="#ff6a00"/>
      <rect x="78" y="25" width="8" height="8" fill="#ff8c33"/>
      <rect x="86" y="25" width="8" height="8" fill="#ff8c33" opacity="0.7"/>
      <rect x="30" y="33" width="8" height="8" fill="#ff6a00"/>
      <rect x="30" y="41" width="8" height="8" fill="#ff6a00"/>
      <rect x="30" y="49" width="8" height="8" fill="#ff6a00"/>
      <rect x="30" y="57" width="8" height="8" fill="#ff6a00"/>
      <rect x="30" y="65" width="8" height="8" fill="#ff8c33"/>
      <rect x="30" y="73" width="8" height="8" fill="#ff8c33" opacity="0.7"/>
      <!-- 内层框 -->
      <rect x="40" y="35" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="46" y="35" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="52" y="35" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="58" y="35" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="40" y="41" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="40" y="47" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
    </g>

    <!-- 双层嵌套像素霓虹框 - 右下 -->
    <g class="frame-bottom-right breathe">
      <rect x="1100" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1092" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1084" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1076" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1068" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1060" y="735" width="8" height="8" fill="#ff6a00"/>
      <rect x="1052" y="735" width="8" height="8" fill="#ff8c33"/>
      <rect x="1044" y="735" width="8" height="8" fill="#ff8c33" opacity="0.7"/>
      <rect x="1100" y="727" width="8" height="8" fill="#ff6a00"/>
      <rect x="1100" y="719" width="8" height="8" fill="#ff6a00"/>
      <rect x="1100" y="711" width="8" height="8" fill="#ff6a00"/>
      <rect x="1100" y="703" width="8" height="8" fill="#ff6a00"/>
      <rect x="1100" y="695" width="8" height="8" fill="#ff8c33"/>
      <rect x="1100" y="687" width="8" height="8" fill="#ff8c33" opacity="0.7"/>
      <!-- 内层框 -->
      <rect x="1090" y="725" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="1084" y="725" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="1078" y="725" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="1072" y="725" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="1090" y="719" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
      <rect x="1090" y="713" width="6" height="6" fill="#ff8c33" opacity="0.4"/>
    </g>

    <!-- 马赛克代码块 -->
    <g class="code-blocks breathe">
      <rect x="45" y="55" width="4" height="4" fill="#ff6a00" opacity="0.6"/>
      <rect x="51" y="55" width="4" height="4" fill="#ff6a00" opacity="0.5"/>
      <rect x="57" y="55" width="4" height="4" fill="#ff8c33" opacity="0.45"/>
      <rect x="63" y="55" width="4" height="4" fill="#ff6a00" opacity="0.4"/>
      <rect x="1070" y="710" width="4" height="4" fill="#ff6a00" opacity="0.6"/>
      <rect x="1076" y="710" width="4" height="4" fill="#ff6a00" opacity="0.5"/>
      <rect x="1082" y="710" width="4" height="4" fill="#ff8c33" opacity="0.45"/>
    </g>

    <!-- 像素十字标记 -->
    <g class="crosses breathe">
      <rect x="1050" y="60" width="6" height="6" fill="#ff6a00"/>
      <rect x="1056" y="60" width="6" height="6" fill="#ff6a00"/>
      <rect x="1062" y="60" width="6" height="6" fill="#ff6a00"/>
      <rect x="1056" y="54" width="6" height="6" fill="#ff6a00"/>
      <rect x="1056" y="66" width="6" height="6" fill="#ff6a00"/>

      <rect x="80" y="700" width="6" height="6" fill="#ff8c33"/>
      <rect x="86" y="700" width="6" height="6" fill="#ff8c33"/>
      <rect x="92" y="700" width="6" height="6" fill="#ff8c33"/>
      <rect x="86" y="694" width="6" height="6" fill="#ff8c33"/>
      <rect x="86" y="706" width="6" height="6" fill="#ff8c33"/>
    </g>

    <!-- 散落方块粒子 -->
    <g class="particles breathe">
      <rect x="400" y="200" width="5" height="5" fill="#ff6a00" opacity="0.4"/>
      <rect x="750" y="150" width="5" height="5" fill="#ff8c33" opacity="0.35"/>
      <rect x="300" y="500" width="4" height="4" fill="#ff6a00" opacity="0.3"/>
      <rect x="900" y="400" width="5" height="5" fill="#ff8c33" opacity="0.35"/>
      <rect x="600" y="650" width="4" height="4" fill="#ff6a00" opacity="0.3"/>
      <rect x="1000" y="300" width="5" height="5" fill="#ff6a00" opacity="0.35"/>
      <rect x="200" y="350" width="4" height="4" fill="#ff8c33" opacity="0.3"/>
      <rect x="500" y="100" width="4" height="4" fill="#ff6a00" opacity="0.3"/>
    </g>

    <!-- 马赛克虚线 -->
    <g class="dashed-lines breathe">
      <rect x="580" y="30" width="6" height="6" fill="#ff6a00" opacity="0.5"/>
      <rect x="580" y="42" width="6" height="6" fill="#ff6a00" opacity="0.4"/>
      <rect x="580" y="54" width="6" height="6" fill="#ff8c33" opacity="0.3"/>
      <rect x="620" y="720" width="6" height="6" fill="#ff6a00" opacity="0.5"/>
      <rect x="620" y="732" width="6" height="6" fill="#ff6a00" opacity="0.4"/>
      <rect x="620" y="744" width="6" height="6" fill="#ff8c33" opacity="0.3"/>
    </g>
  </svg>
</div>

<style>
  .background-pattern {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .pattern-svg {
    width: 100%;
    height: 100%;
    opacity: var(--pattern-opacity);
  }

  .breathe {
    animation: breathe 6s ease-in-out infinite;
  }

  .frame-bottom-right {
    animation-delay: 3s;
  }

  .crosses {
    animation-delay: 1.5s;
  }

  .particles {
    animation-delay: 4.5s;
  }
</style>
