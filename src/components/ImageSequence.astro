---
interface Props {
  images: string[];
  fps?: number;
  alt?: string;
  loop?: boolean;
}

const { images, fps = 2, alt = '', loop = true } = Astro.props;
const interval = Math.round(1000 / fps);
const id = `seq-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="image-sequence" data-seq-id={id} data-interval={interval} data-loop={loop ? '1' : '0'}>
  <div class="seq-frame">
    {images.map((src, i) => (
      <img src={src} alt={alt} class={i === 0 ? 'active' : ''} loading="eager" />
    ))}
  </div>
  <div class="seq-controls">
    <button type="button" class="seq-btn" data-action="toggle" aria-label="播放/暂停">⏸</button>
    <div class="seq-progress">
      <div class="seq-progress-bar"></div>
    </div>
    <span class="seq-counter">1 / {images.length}</span>
  </div>
</div>

<style>
  .image-sequence {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    margin: 0.5rem 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .seq-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .seq-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.08s linear;
  }

  .seq-frame img.active {
    opacity: 1;
  }

  .seq-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid var(--color-card-border);
  }

  .seq-btn {
    background: transparent;
    border: 1px solid var(--color-card-border);
    color: var(--color-primary-light);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1;
    padding: 0;
    transition: border-color 0.2s, color 0.2s;
  }

  .seq-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .seq-progress {
    flex: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .seq-progress-bar {
    height: 100%;
    background: var(--color-primary);
    width: 0%;
    transition: width 0.1s linear;
  }

  .seq-counter {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 4rem;
    text-align: right;
  }
</style>

<script>
  function initSequences() {
    document.querySelectorAll<HTMLElement>('.image-sequence').forEach((el) => {
      if (el.dataset.bound === '1') return;
      el.dataset.bound = '1';

      const interval = Number(el.dataset.interval) || 500;
      const loop = el.dataset.loop === '1';
      const frames = el.querySelectorAll<HTMLImageElement>('.seq-frame img');
      const bar = el.querySelector<HTMLElement>('.seq-progress-bar');
      const counter = el.querySelector<HTMLElement>('.seq-counter');
      const btn = el.querySelector<HTMLButtonElement>('.seq-btn');
      if (!frames.length) return;

      let index = 0;
      let timer: number | null = null;
      let playing = true;

      const render = () => {
        frames.forEach((f, i) => f.classList.toggle('active', i === index));
        if (bar) bar.style.width = `${((index + 1) / frames.length) * 100}%`;
        if (counter) counter.textContent = `${index + 1} / ${frames.length}`;
      };

      const tick = () => {
        index += 1;
        if (index >= frames.length) {
          if (loop) {
            index = 0;
          } else {
            index = frames.length - 1;
            stop();
            return;
          }
        }
        render();
      };

      const start = () => {
        if (timer !== null) return;
        timer = window.setInterval(tick, interval);
        playing = true;
        if (btn) btn.textContent = '⏸';
      };

      const stop = () => {
        if (timer !== null) {
          clearInterval(timer);
          timer = null;
        }
        playing = false;
        if (btn) btn.textContent = '▶';
      };

      btn?.addEventListener('click', () => {
        if (playing) stop();
        else start();
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (playing) start();
          } else {
            if (timer !== null) {
              clearInterval(timer);
              timer = null;
            }
          }
        });
      }, { threshold: 0.2 });
      io.observe(el);

      render();
    });
  }

  initSequences();
  document.addEventListener('astro:after-swap', initSequences);
</script>
