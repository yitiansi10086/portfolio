---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title}>
  <article class="project-detail">
    <a href="/" class="back-link">&larr; 返回作品集</a>
    <h1 class="project-title">{project.data.title}</h1>
    <p class="project-description">{project.data.description}</p>

    <div class="project-tools">
      {project.data.tools.map((tool) => (
        <span class="tool-tag">{tool}</span>
      ))}
    </div>

    <div class="project-cover">
      <img src={project.data.cover} alt={project.data.title} />
    </div>

    <div class="project-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    max-width: 1100px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .project-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .project-description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tool-tag {
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    background: rgba(255, 106, 0, 0.1);
    border: 1px solid rgba(255, 106, 0, 0.3);
    border-radius: 4px;
    color: var(--color-primary-light);
  }

  .project-cover {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2.5rem;
    border: 1px solid var(--color-card-border);
  }

  .project-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project-content {
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .project-content :global(h2) {
    color: var(--color-text);
    font-size: 1.4rem;
    margin: 2rem 0 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1rem;
  }

  .project-content :global(img) {
    width: 30%;
    display: inline-block;
    margin: 0.5rem 1% 0.5rem 0;
    border-radius: 8px;
    border: 1px solid var(--color-card-border);
  }

  .project-content :global(img[width="64"]) {
    width: 64px;
    height: 64px;
    margin: 0 16px 0 0;
    border: none;
  }

  .project-content :global(div img) {
    border: none;
  }
    border-radius: 0;
  }
</style>
